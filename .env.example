NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Tests and verification scripts (Playwright, scripts/verify.ts). Values are held by the project owner in secure offline storage;
# --- NEVER commit them. Leave unset for normal development.
# E2E_SUPABASE_URL=            # a LOCAL stack (http://127.0.0.1:<port>) for anything that writes data
# E2E_SUPABASE_ANON_KEY=
# E2E_PATIENT_EMAIL=
# E2E_PATIENT_PASSWORD=
# E2E_RECEPTIONIST_EMAIL=
# E2E_RECEPTIONIST_PASSWORD=
# E2E_NURSE_EMAIL=
# E2E_NURSE_PASSWORD=
# E2E_NURSE2_EMAIL=            # nurses 2-3: used only by scripts/rotate-demo-passwords.ts (and manual demos)
# E2E_NURSE3_EMAIL=
# E2E_ADMIN_EMAIL=
# E2E_ADMIN_PASSWORD=
# E2E_ENABLE_DESTRUCTIVE=      # 1 = also run the suites that write or submit (local stack only; any other non-empty value is refused)
# E2E_BASE_URL=                # the app you started yourself — write it as http://localhost:<port> (Next dev blocks HMR from 127.0.0.1)
